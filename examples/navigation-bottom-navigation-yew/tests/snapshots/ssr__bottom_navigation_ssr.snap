<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><title>RusticUI Yew Bottom Navigation</title><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="navigation-bottom-navigation-root" data-rustic-bottom-nav="navigation.bottom"><nav class="stylist-style-0" role="tablist" id="navigation-bottom-navigation-root" aria-labelledby="navigation-bottom-label" data-rustic-analytics-channel="navigation.bottom" data-component="rustic_ui_bottom_navigation" data-rustic-bottom-navigation-root="true" data-selected-index="0" data-on-select="navigation.bottom.select"><button class="stylist-style-1" role="tab" aria-selected="true" tabindex="0" data-rustic-bottom-navigation-index="0" data-rustic-bottom-navigation-item-0="true" data-component="rustic_ui_bottom_navigation_item">Overview</button><button class="stylist-style-1" role="tab" aria-selected="false" tabindex="-1" data-rustic-bottom-navigation-index="1" data-rustic-bottom-navigation-item-1="true" data-component="rustic_ui_bottom_navigation_item">Analytics</button><button class="stylist-style-1" role="tab" aria-selected="false" tabindex="-1" data-rustic-bottom-navigation-index="2" data-rustic-bottom-navigation-item-2="true" data-component="rustic_ui_bottom_navigation_item">Deployments</button><button class="stylist-style-1" role="tab" aria-selected="false" tabindex="-1" data-rustic-bottom-navigation-index="3" data-rustic-bottom-navigation-item-3="true" data-component="rustic_ui_bottom_navigation_item">Billing</button></nav></div><pre data-rustic-analytics-log>{&quot;channel&quot;:&quot;navigation.bottom&quot;,&quot;item_tag&quot;:&quot;destination.overview&quot;,&quot;index&quot;:0,&quot;occurred_at&quot;:&quot;2024-01-01T12:00:00Z&quot;}</pre></body></html>
