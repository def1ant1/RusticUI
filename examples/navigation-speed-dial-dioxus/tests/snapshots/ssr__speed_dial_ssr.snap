<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><title>RusticUI Dioxus Speed Dial</title><meta name="viewport" content="width=device-width, initial-scale=1" /></head><body><div id="speed-dial-root" data-rustic-speed-dial="navigation.speed_dial"><div class="stylist-style-0" data-component="rustic_ui_speed_dial" data-rustic-speed-dial-root="true" data-on-toggle="navigation.speed_dial.toggle"><button class="stylist-style-1" role="button" aria-expanded="false" aria-haspopup="menu" id="speed-dial-trigger" data-rustic-analytics-channel="navigation.speed_dial" data-rustic-analytics-id="trigger.create" data-rustic-speed-dial-state="closed" data-component="rustic_ui_speed_dial_trigger" data-state="closed"><span aria-hidden="true">＋</span><span class="sr-only">Open speed dial</span></button><ul class="stylist-style-2" role="menu" data-rustic-speed-dial="actions" data-rustic-analytics-channel="navigation.speed_dial" data-on-activate="navigation.speed_dial.action"><li class="stylist-style-3" data-rustic-speed-dial-item-0="true" data-component="rustic_ui_speed_dial_item"><button class="stylist-style-4" role="menuitem" tabindex="0" data-rustic-analytics-id="action.create" data-rustic-analytics-channel="navigation.speed_dial" aria-label="Create a new incident" data-rustic-speed-dial-index="0" data-component="rustic_ui_speed_dial_action">Create incident</button></li><li class="stylist-style-3" data-rustic-speed-dial-item-1="true" data-component="rustic_ui_speed_dial_item"><button class="stylist-style-4" role="menuitem" tabindex="-1" data-rustic-analytics-id="action.escalate" data-rustic-analytics-channel="navigation.speed_dial" aria-label="Escalate the current incident to the on-call engineer" data-rustic-speed-dial-index="1" data-component="rustic_ui_speed_dial_action">Escalate to on-call</button></li><li class="stylist-style-3" data-rustic-speed-dial-item-2="true" data-component="rustic_ui_speed_dial_item"><button class="stylist-style-4" role="menuitem" tabindex="-1" data-rustic-analytics-id="action.archive" data-rustic-analytics-channel="navigation.speed_dial" aria-label="Archive the resolved incident" data-rustic-speed-dial-index="2" data-component="rustic_ui_speed_dial_action">Archive incident</button></li></ul></div></div><pre data-rustic-analytics-log>{&quot;channel&quot;:&quot;navigation.speed_dial&quot;,&quot;event&quot;:&quot;action&quot;,&quot;action_index&quot;:0,&quot;action_tag&quot;:&quot;action.create&quot;,&quot;occurred_at&quot;:&quot;2024-01-01T12:00:00Z&quot;}</pre></body></html>
