{
  "name": "@rusticui/selection-controls-react-example",
  "version": "0.1.0",
  "private": true,
  "description": "React + wasm selection control automation harness powered by Rust",
  "scripts": {
    "clean": "rimraf web/pkg web/dist",
    "build:wasm": "wasm-pack build --target web --out-dir web/pkg --out-name selection_controls",
    "build:wasm:dev": "wasm-pack build --target web --dev --out-dir web/pkg --out-name selection_controls",
    "build:web": "npm run build:wasm && vite build --config web/vite.config.ts",
    "dev": "concurrently \"npm:build:wasm:dev -- --watch\" \"vite dev --config web/vite.config.ts\"",
    "test:rust": "cargo test -p selection-controls-react",
    "test:wasm": "wasm-pack test --headless --chrome",
    "test:jest": "jest --config web/jest.config.ts",
    "test:e2e": "playwright test --config=web/playwright.config.ts",
    "test:web": "npm run build:wasm && npm run test:jest && npm run test:e2e",
    "test": "npm run test:rust && npm run test:wasm && npm run test:web",
    "fmt": "cargo fmt --all && prettier --config web/.prettierrc.json --write \"web/src/**/*.{ts,tsx}\"",
    "lint": "eslint --config web/.eslintrc.cjs \"web/src/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.15.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.44.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vite": "^5.1.0"
  }
}
