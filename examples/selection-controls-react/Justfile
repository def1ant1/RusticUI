set shell := ["bash", "-cu"]

# Helper to execute npm commands within this example directory.
_export_npm := "cd {{justfile_directory()}} && npm"

alias npm := "{{_export_npm}}"

bootstrap:
    rustup target add wasm32-unknown-unknown
    cd {{justfile_directory()}} && npm install

build:
    cd {{justfile_directory()}} && cargo build -p selection-controls-react
    cd {{justfile_directory()}} && cargo build -p selection-controls-react --target wasm32-unknown-unknown
    cd {{justfile_directory()}} && npm run build:web

test:
    cd {{justfile_directory()}} && npm run test

dev:
    cd {{justfile_directory()}} && npm run dev

fmt:
    cd {{justfile_directory()}} && npm run fmt

lint:
    cd {{justfile_directory()}} && npm run lint

automation-smoke:
    cd {{justfile_directory()}} && ./scripts/automation-smoke.sh

automation-serve:
    cd {{justfile_directory()}} && ../scripts/selection-controls-smoke.sh react --mode serve --port {{env_var("SELECTION_CONTROLS_REACT_PORT", "4704")}}
